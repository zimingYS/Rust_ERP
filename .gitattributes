# 统一仓库内换行为 LF，避免 Windows / Linux 混合开发产生整文件 diff
* text=auto eol=lf

*.rs    text eol=lf
*.toml  text eol=lf
*.lock  text eol=lf
*.md    text eol=lf
*.cff   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.sh    text eol=lf

# Windows 脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制资源禁止换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.xlsx  binary
*.pdf   binary
