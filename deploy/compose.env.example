# docker compose 环境变量示例（占位值，请勿填写真实生产口令）
# 用法：cp deploy/compose.env.example deploy/compose.env
#       docker compose --env-file deploy/compose.env up -d --build
# deploy/compose.env 已被 .gitignore 忽略，不会入库。

POSTGRES_DB=erp_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_before_use
FRONTEND_PORT=8080
RUST_LOG=info

# 使用 GHCR 预构建镜像时填写（自动部署工作流会设置 ERP_VERSION）
GHCR_OWNER=zimingys
ERP_VERSION=latest

# 注意：口令包含 @ : / # ? 等特殊字符时必须做 URL 百分比编码，
# 否则 docker-compose.yml 中拼接的 DATABASE_URL 会解析失败。
